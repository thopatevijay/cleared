{
  "name": "@cleared/evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./gold/schema": "./src/gold/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "sh -c '[ \"$1\" = -- ] && shift; exec vitest run \"$@\"' vitest",
    "eval:draft": "node src/gold/draft.ts",
    "eval:review": "node src/gold/review.ts",
    "eval:label": "node src/gold/label.ts",
    "eval:validate": "node src/gold/validate.ts"
  },
  "dependencies": {
    "@cleared/adapters": "workspace:*",
    "@cleared/core": "workspace:*",
    "zod": "4.6.7"
  }
}

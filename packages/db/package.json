{
  "name": "@cleared/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "node src/migrate.ts",
    "generate": "drizzle-kit generate",
    "seed": "node src/seed.ts",
    "count": "node src/count.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "sh -c '[ \"$1\" = -- ] && shift; exec vitest run \"$@\"' vitest",
    "test:security": "vitest run test/grants.test.ts test/constraints.test.ts test/agent-runs.test.ts"
  },
  "dependencies": {
    "@cleared/core": "workspace:*",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11"
  }
}

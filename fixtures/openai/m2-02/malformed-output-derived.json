                    }
                  },
                  "required": ["kind", "statement", "quote"],
                  "additionalProperties": false
                }
              },
              "instruction_like_lines": {
                "maxItems": 10,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 400
                }
              }
            },
            "required": ["evidence_id", "item_kind", "summary", "facts", "instruction_like_lines"],
            "additionalProperties": false
          },
          "strict": true
        }
      },

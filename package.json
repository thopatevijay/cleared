{
  "name": "cleared",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "pnpm -r run typecheck && pnpm -r run lint && pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "lint": "pnpm -r run lint",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "i18n:check": "node scripts/check-i18n.ts",
    "lhci": "node apps/web/scripts/lhci.ts",
    "db:migrate": "pnpm --filter @cleared/db --if-present run migrate",
    "db:seed": "pnpm --filter @cleared/db --if-present run seed",
    "db:count": "pnpm --filter @cleared/db --if-present run count",
    "build": "pnpm -r --if-present run build",
    "load:launch": "node scripts/load/launch.ts",
    "load:burst": "node scripts/load/webhook-burst.ts",
    "load:assert": "node scripts/load/run.ts",
    "load:server-timing": "node scripts/load/server-timing.ts",
    "start:all": "pnpm --parallel --filter @cleared/web --filter @cleared/worker --if-present run start",
    "test:security": "pnpm -r --if-present run test:security",
    "security:check-doc": "node scripts/check-security-doc.ts",
    "runbook:check": "node scripts/check-runbook.ts",
    "eval": "pnpm --filter @cleared/evals --if-present run eval",
    "eval:validate": "pnpm --filter @cleared/evals --if-present run eval:validate",
    "eval:check-readme": "pnpm --filter @cleared/evals --if-present run eval:check-readme",
    "eval:draft": "pnpm --filter @cleared/evals --if-present run eval:draft",
    "eval:report": "pnpm --filter @cleared/evals --if-present run eval:report",
    "eval:review": "pnpm --filter @cleared/evals --if-present run eval:review",
    "eval:label": "pnpm --filter @cleared/evals --if-present run eval:label",
    "eval:adopt-dev": "pnpm --filter @cleared/evals --if-present run eval:adopt-dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.15.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}

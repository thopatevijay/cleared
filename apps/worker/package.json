{
  "name": "@cleared/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "sandbox:pay": "node src/cli/sandbox-pay.ts",
    "synthetic": "node src/cli/synthetic.ts",
    "pool:create": "node src/cli/pool.ts create",
    "pool:capture": "node src/cli/pool.ts capture",
    "pool:status": "node src/cli/pool.ts status",
    "pool:assign": "node src/cli/pool.ts assign",
    "build": "tsc --noEmit -p .",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "test": "sh -c '[ \"$1\" = -- ] && shift; exec vitest run \"$@\"' vitest"
  },
  "dependencies": {
    "@cleared/adapters": "workspace:*",
    "@cleared/core": "workspace:*",
    "@cleared/db": "workspace:*",
    "@sentry/node": "11.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "msw": "3.0.3"
  }
}

{
  "$comment": "Source of truth for Cleared's design tokens (M1-06). Edit here, then run `node scripts/design-tokens.mjs` to regenerate apps/web/src/styles/tokens.css, and `--check` to verify contrast and drift. Colour names become Tailwind 4 vars --color-<name>. Rationale lives in docs/design/README.md.",
  "color": {
    "light": {
      "bg": "#f4f6f8",
      "surface": "#ffffff",
      "surface-sunken": "#e9edf1",
      "text": "#18202b",
      "text-muted": "#4a5565",
      "border": "#d3d9e0",
      "border-strong": "#6b7685",
      "accent": "#0a5c66",
      "accent-hover": "#074a52",
      "on-accent": "#ffffff",
      "focus": "#2348c4",
      "danger": "#b42318",
      "on-danger": "#ffffff",
      "highlight": "#fff1a8",
      "inverse-bg": "#1f2733",
      "inverse-text": "#f4f6f8",
      "focus-inverse": "#9db4ff",
      "skeleton": "#dfe4ea",
      "status-completed-bg": "#dff3ea",
      "status-completed-fg": "#0c5a3f",
      "status-held-bg": "#fdedd3",
      "status-held-fg": "#7a4300",
      "status-dispute-bg": "#f6e3ef",
      "status-dispute-fg": "#7e1d5c",
      "status-error-bg": "#fde6e1",
      "status-error-fg": "#9a2412",
      "status-neutral-bg": "#e8ebef",
      "status-neutral-fg": "#39424f",
      "status-info-bg": "#e2ecfb",
      "status-info-fg": "#1c4589",
      "status-sandbox-bg": "#f0eee6",
      "status-sandbox-fg": "#4d4733"
    },
    "dark": {
      "bg": "#141920",
      "surface": "#1b222b",
      "surface-sunken": "#0f1318",
      "text": "#e7ebf0",
      "text-muted": "#a7b0bd",
      "border": "#2e3743",
      "border-strong": "#7f8a99",
      "accent": "#5fc2cc",
      "accent-hover": "#82d3db",
      "on-accent": "#062b30",
      "focus": "#8eaaff",
      "danger": "#ff8a7a",
      "on-danger": "#3a0b05",
      "highlight": "#5a4a00",
      "inverse-bg": "#e7ebf0",
      "inverse-text": "#141920",
      "focus-inverse": "#2348c4",
      "skeleton": "#252d38",
      "status-completed-bg": "#123528",
      "status-completed-fg": "#8fe0bd",
      "status-held-bg": "#3a2a0c",
      "status-held-fg": "#f6c46e",
      "status-dispute-bg": "#3a1730",
      "status-dispute-fg": "#f2a6d4",
      "status-error-bg": "#42170f",
      "status-error-fg": "#ffab9c",
      "status-neutral-bg": "#262e39",
      "status-neutral-fg": "#c3cad4",
      "status-info-bg": "#15284a",
      "status-info-fg": "#a9c6f5",
      "status-sandbox-bg": "#2f2c22",
      "status-sandbox-fg": "#d9d1b0"
    },
    "status": {
      "completed": {
        "fg": "status-completed-fg",
        "bg": "status-completed-bg",
        "icon": "status-completed-fg",
        "iconName": "circle-check",
        "label": { "en": "Completed", "hi": "पूरा हुआ" },
        "paypal": "capture status COMPLETED (also: a held capture released back to COMPLETED)"
      },
      "held": {
        "fg": "status-held-fg",
        "bg": "status-held-bg",
        "icon": "status-held-fg",
        "iconName": "hourglass",
        "label": { "en": "Held", "hi": "रोका गया" },
        "paypal": "capture status PENDING + status_details.reason (e.g. PENDING_REVIEW, BUYER_COMPLAINT); the reason is shown beside the badge"
      },
      "dispute": {
        "fg": "status-dispute-fg",
        "bg": "status-dispute-bg",
        "icon": "status-dispute-fg",
        "iconName": "scale",
        "label": { "en": "In dispute", "hi": "विवाद में" },
        "paypal": "dispute status OPEN, WAITING_FOR_SELLER_RESPONSE, WAITING_FOR_BUYER_RESPONSE or UNDER_REVIEW (the PayPal status is shown beside the badge)"
      },
      "resolved": {
        "fg": "status-neutral-fg",
        "bg": "status-neutral-bg",
        "icon": "status-neutral-fg",
        "iconName": "flag",
        "label": { "en": "Resolved", "hi": "निपटारा हुआ" },
        "paypal": "dispute status RESOLVED; the meaning comes from dispute_outcome.outcome_code (neutral colour on purpose: resolved is not the same as good news)"
      },
      "refunded": {
        "fg": "status-neutral-fg",
        "bg": "status-neutral-bg",
        "icon": "status-neutral-fg",
        "iconName": "undo-2",
        "label": { "en": "Refunded", "hi": "रिफ़ंड हुआ" },
        "paypal": "capture status REFUNDED or PARTIALLY_REFUNDED (partial adds the refunded amount)"
      },
      "failed": {
        "fg": "status-error-fg",
        "bg": "status-error-bg",
        "icon": "status-error-fg",
        "iconName": "circle-x",
        "label": { "en": "Not completed", "hi": "पूरा नहीं हुआ" },
        "paypal": "capture status DECLINED or FAILED (the PayPal status is shown beside the badge)"
      },
      "quarantined": {
        "fg": "status-error-fg",
        "bg": "status-error-bg",
        "icon": "status-error-fg",
        "iconName": "shield-alert",
        "label": { "en": "Quarantined", "hi": "अलग रखा गया" },
        "paypal": "none: a Cleared state for a PayPal resource with no owner workspace (paypal_resource_owner); never a PayPal status"
      },
      "info": {
        "fg": "status-info-fg",
        "bg": "status-info-bg",
        "icon": "status-info-fg",
        "iconName": "info",
        "label": { "en": "Info", "hi": "जानकारी" },
        "paypal": "none: informational notes (source tags such as via webhook, estimates, notices)"
      },
      "sandbox": {
        "fg": "status-sandbox-fg",
        "bg": "status-sandbox-bg",
        "icon": "status-sandbox-fg",
        "iconName": "flask-conical",
        "label": { "en": "Sandbox", "hi": "सैंडबॉक्स" },
        "paypal": "PAYPAL_ENV=sandbox: sandbox-only controls (test payment, Simulate PayPal's decision) and sample scenarios"
      }
    }
  },
  "contrast": [
    { "fg": "text", "bg": "bg", "min": 4.5, "use": "body text on page" },
    { "fg": "text", "bg": "surface", "min": 4.5, "use": "body text on rows, panels, cards" },
    { "fg": "text", "bg": "surface-sunken", "min": 4.5, "use": "text in code/hash blocks, estimated chip, inputs" },
    { "fg": "text", "bg": "highlight", "min": 4.5, "use": "quoted span highlighted in evidence" },
    { "fg": "text-muted", "bg": "bg", "min": 4.5, "use": "secondary text on page (footer, timestamps)" },
    { "fg": "text-muted", "bg": "surface", "min": 4.5, "use": "secondary text in rows (ISO code, time, source tag)" },
    { "fg": "text-muted", "bg": "surface-sunken", "min": 4.5, "use": "secondary text in sunken blocks, disabled control labels" },
    { "fg": "accent", "bg": "bg", "min": 4.5, "use": "link text on page" },
    { "fg": "accent", "bg": "surface", "min": 4.5, "use": "link text and secondary button label on rows" },
    { "fg": "accent", "bg": "surface-sunken", "min": 4.5, "use": "link text inside sunken blocks (source disclosure)" },
    { "fg": "on-accent", "bg": "accent", "min": 4.5, "use": "primary button label" },
    { "fg": "on-accent", "bg": "accent-hover", "min": 4.5, "use": "primary button label, hover/pressed" },
    { "fg": "danger", "bg": "surface", "min": 4.5, "use": "destructive secondary button label, field error text" },
    { "fg": "danger", "bg": "bg", "min": 4.5, "use": "field error text on page" },
    { "fg": "on-danger", "bg": "danger", "min": 4.5, "use": "destructive primary button label (Accept claim)" },
    { "fg": "inverse-text", "bg": "inverse-bg", "min": 4.5, "use": "toast text and toast action" },
    { "fg": "border-strong", "bg": "surface", "min": 3, "use": "input, checkbox and secondary button boundary on surface" },
    { "fg": "border-strong", "bg": "bg", "min": 3, "use": "input and secondary button boundary on page" },
    { "fg": "border-strong", "bg": "surface-sunken", "min": 3, "use": "dashed boundary of estimated chip and sandbox control" },
    { "fg": "accent", "bg": "surface", "min": 3, "use": "primary button boundary vs surface (UI component)" },
    { "fg": "focus", "bg": "bg", "min": 3, "use": "focus ring on page" },
    { "fg": "focus", "bg": "surface", "min": 3, "use": "focus ring on rows and panels" },
    { "fg": "focus", "bg": "surface-sunken", "min": 3, "use": "focus ring inside sunken blocks" },
    { "fg": "focus-inverse", "bg": "inverse-bg", "min": 3, "use": "focus ring on toast action (inverse surface)" },
    { "fg": "status-held-fg", "bg": "surface", "min": 4.5, "use": "route-advice warning text and deadline countdown on rows" },
    { "fg": "status-error-fg", "bg": "surface", "min": 4.5, "use": "error panel heading on surface" },
    { "fg": "status-completed-fg", "bg": "surface", "min": 3, "use": "status rail and icon on row edge (non-text)" },
    { "fg": "status-held-fg", "bg": "bg", "min": 3, "use": "status rail and icon on page (non-text)" },
    { "fg": "status-dispute-fg", "bg": "surface", "min": 3, "use": "status rail and icon on row edge (non-text)" },
    { "fg": "status-error-fg", "bg": "bg", "min": 3, "use": "status rail and icon on page (non-text)" },
    { "fg": "status-info-fg", "bg": "surface", "min": 4.5, "use": "info note text (via webhook tag) without badge fill" },
    { "fg": "status-neutral-fg", "bg": "surface", "min": 4.5, "use": "neutral note text without badge fill" },
    { "fg": "status-sandbox-fg", "bg": "surface", "min": 4.5, "use": "sandbox label text on outlined control" }
  ],
  "font": {
    "sans": "'Atkinson Hyperlegible Next', 'Noto Sans', system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
    "devanagari": "'Noto Sans Devanagari', 'Atkinson Hyperlegible Next', 'Noto Sans', system-ui, sans-serif",
    "mono": "'Atkinson Hyperlegible Mono', ui-monospace, 'SFMono-Regular', Menlo, Consolas, monospace"
  },
  "text": {
    "xs": { "size": "13px", "lineHeight": "1.45", "lineHeightHi": "1.7", "weight": 400 },
    "sm": { "size": "14px", "lineHeight": "1.5", "lineHeightHi": "1.75", "weight": 400 },
    "base": { "size": "16px", "lineHeight": "1.5", "lineHeightHi": "1.75", "weight": 400 },
    "lg": { "size": "18px", "lineHeight": "1.45", "lineHeightHi": "1.7", "weight": 500 },
    "xl": { "size": "22px", "lineHeight": "1.3", "lineHeightHi": "1.6", "weight": 600 },
    "2xl": { "size": "28px", "lineHeight": "1.2", "lineHeightHi": "1.5", "weight": 700 },
    "money": { "size": "34px", "lineHeight": "1.1", "lineHeightHi": "1.4", "weight": 700 }
  },
  "spacing": { "base": "4px" },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "12px",
    "pill": "999px"
  },
  "shadow": {
    "light": {
      "raised": "0 1px 2px rgb(24 32 43 / 0.08), 0 0 0 1px rgb(24 32 43 / 0.06)",
      "overlay": "0 8px 24px rgb(24 32 43 / 0.18), 0 0 0 1px rgb(24 32 43 / 0.08)"
    },
    "dark": {
      "raised": "0 0 0 1px rgb(231 235 240 / 0.10)",
      "overlay": "0 8px 24px rgb(0 0 0 / 0.55), 0 0 0 1px rgb(231 235 240 / 0.14)"
    }
  },
  "motion": {
    "duration": { "instant": "80ms", "quick": "150ms", "settle": "240ms" },
    "ease": { "standard": "cubic-bezier(0.2, 0, 0, 1)", "exit": "cubic-bezier(0.3, 0, 1, 1)" }
  },
  "breakpoint": { "sm": "375px", "md": "768px", "xl": "1440px" },
  "z": { "base": 0, "sticky": 10, "drawer": 20, "dialog": 30, "toast": 40 }
}

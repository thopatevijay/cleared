# Copy to .env and fill. Never commit .env. Values live only in .env (local) and the Render environment.
# Labels: [required] the app won't boot without it · [flow] needed for the PayPal/AI flow ·
# [optional] the app runs without it · [test] only for test or eval runs. Unlabelled lines have working defaults.

# --- App ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
# [required] at least 32 characters: `openssl rand -base64 32`
SESSION_SECRET=
# Kill switch for all agent-initiated executions (true = stop)
AGENT_KILL_SWITCH=false

# --- Database ---
DATABASE_URL=postgres://cleared:cleared@localhost:5432/cleared

# --- PayPal (sandbox REST app of the platform) ---
# Only "sandbox" is supported
PAYPAL_ENV=sandbox
# [flow]
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# [flow] printed by scripts/setup.ts when it registers the webhook
PAYPAL_WEBHOOK_ID=

# --- OpenAI ---
# [flow] without it the AI steps show no verdict (never a made-up one)
OPENAI_API_KEY=
# Pinned model IDs (verified in M0-07)
OPENAI_MODEL_SMALL=gpt-6-luna
OPENAI_MODEL_LARGE=gpt-6.1-terra
LLM_DAILY_CAP_USD=1
LLM_WORKSPACE_CAP_USD=0.10

# --- Email (Resend) ---
# [optional] without them no email is sent
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated. When set, email goes ONLY to these addresses (verified test recipients)
EMAIL_RECIPIENT_ALLOWLIST=

# --- Observability ---
# [optional]
SENTRY_DSN=
LOG_LEVEL=info

# --- Demo workspace limits ---
DEMO_WORKSPACES_PER_IP_PER_DAY=3
DEMO_WORKSPACES_GLOBAL_MAX=200

# --- Deploy / test runs (not secrets) ---
# Public URL of the Render web service (scripts/setup.ts default)
RENDER_WEB_URL=https://cleared-web-gd1b.onrender.com
# [test] Playwright base URL for runs against a deployed environment
E2E_BASE_URL=
# [test] spend cap per live eval run (M4-02)
EVAL_MAX_USD=1

# --- [optional] Bryntum private npm registry: only for a licensed calendar build (the public trial needs none) ---
BRYNTUM_NPM_TOKEN=

# [test] never set in production: fake clock for purge dry runs; output dir for PDF size checks
# FAKE_NOW=
# PDF_OUT_DIR=

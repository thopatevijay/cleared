# Copy to .env and fill. Never commit .env. Values live only in .env (local) and the Render environment.

# --- App ---
NODE_ENV=development
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=
# 32-byte key, base64, for AES-256-GCM encryption of stored secrets
ENCRYPTION_KEY=
# Kill switch for all agent-initiated executions (true = stop)
AGENT_KILL_SWITCH=false

# --- Database ---
DATABASE_URL=postgres://cleared:cleared@localhost:5432/cleared

# --- PayPal (sandbox REST app of the platform) ---
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# --- OpenAI ---
OPENAI_API_KEY=
# Model IDs are verified in M0-07 and pinned here
OPENAI_MODEL_SMALL=
OPENAI_MODEL_LARGE=
LLM_DAILY_CAP_USD=1
LLM_WORKSPACE_CAP_USD=0.10

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated. When set, email goes ONLY to these addresses (verified test recipients)
EMAIL_RECIPIENT_ALLOWLIST=

# --- Observability ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Demo workspace limits ---
DEMO_WORKSPACES_PER_IP_PER_DAY=3
DEMO_WORKSPACES_GLOBAL_MAX=200

# --- Deploy / test runs (not secrets) ---
# Public URL of the Render web service (set in M0-08)
RENDER_WEB_URL=
# Playwright base URL for runs against a deployed environment
E2E_BASE_URL=
# Spend cap per live eval run (M4-02)
EVAL_MAX_USD=1

# --- Optional: Bryntum private npm registry (only if Bryntum is used in the product build, M3-05) ---
BRYNTUM_NPM_TOKEN=

# Test-only (never set in production): fake clock for purge dry runs; output dir for PDF size checks
# FAKE_NOW=
# PDF_OUT_DIR=
